# House-inspired shuffle sketch. All moves last two beats.
# Columns: move, leading foot, travel (metres), lift (metres).
phrase basic
    groove jack 0.6
    arms counter left 0.65 0.12
    shuffle left  0.24 0.10
    shuffle right 0.24 0.10
    arms sweep left 0.65 0.12
    side_step left  0.22 0.07
    arms pull right 0.65 0.10
    side_step right 0.22 0.07
end

phrase open
    groove jack 0.9
    arms counter left 0.9 0.16
    shuffle left  0.28 0.13
    arms sweep right 0.9 0.16
    shuffle right 0.28 0.13
    arms sweep left 1.0 0.14
    side_step left  0.28 0.09
    arms pull right 0.9 0.12
    side_step right 0.28 0.09
end

# 2 x 8 beats + 2 x 8 beats = eight bars / 15.36 seconds at 125 BPM.
play basic 2
play open 2
